# Copy to .env.local (gitignored). EXPO_PUBLIC_* values are inlined at bundle time: restart Metro after changing them.

# Backend base URL, without /api/v1. Defaults to http://127.0.0.1:8000 (http://10.0.2.2:8000 on Android).
# On a physical device, use your machine's LAN IP, e.g. http://192.168.1.20:8000
EXPO_PUBLIC_API_URL=http://127.0.0.1:8000

# Set to 1 to use the in-app AsyncStorage mock backend instead of the server.
EXPO_PUBLIC_USE_MOCK=
